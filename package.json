  "scripts": {
    "test": "vitest run && pnpm --dir server test",
    "dev": "run-p dev:*",
    "dev:app": "next",
    "dev:path": "pathpida --watch",
    "dev:server": "pnpm --dir server dev",
    "compile": "run-p compile:*",
    "compile:prisma": "pnpm --dir server build:prisma",
    "compile:pathpida": "pathpida",
    "build": "run-s compile build:static build:server build:export",
    "build:static": "run-p build:{license,storybook,next}",
    "build:license": "NODE_ENV=development pnpm licenses list -r --json | pnpm-licenses generate-disclaimer --json-input --output-file public/LICENSE",
    "build:storybook": "storybook build -o public/storybook",
    "build:next": "next build",
    "build:export": "next export -o server/dist/public",
    "build:server": "pnpm --dir server build:app",
    "build:openapi": "openapi-generator-cli generate",
    "zoom:import": "pnpm --dir server zoom:import",
    "start": "pnpm --dir server start",
    "vercel-build": "run-s compile build:static build:server && rm -rf public/api/v2/swagger && mkdir -p public/api/v2/swagger && cp -a server/dist/static public/api/v2/swagger/static",
    "format": "prettier --write .",
    "typecheck": "run-s compile typecheck:tsc",
    "typecheck:tsc": "tsc --noEmit --incremental false",
    "lint": "run-s compile 'lint:eslint {@}' --",
    "lint:eslint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "pnpm run lint -- --fix",
    "lint:fix:report": "pnpm run lint:fix -- --output-file eslint_report.json --format json",
    "storybook": "storybook dev -s ./public"
  },
  "engines": {
    "node": ">=26.2.0 || ^24.16.0 || ^22.22.3"
  }
}
