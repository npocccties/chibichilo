{
  "name": "chibichilo-server",
  "version": "2.5.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/npocccties/chibichilo",
    "directory": "server"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "run-s dev:setup dev:serve",
    "dev:setup": "run-s build:prisma migrate seed",
    "dev:serve": "tsdown --watch --on-success 'node dist/index.js | pino-pretty'",
    "build": "run-s build:prisma build:app",
    "build:app": "tsdown",
    "build:prisma": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "seed": "prisma db seed",
    "data-migration": "tsx prisma/data_migration.ts",
    "zoom:import": "tsx utils/zoom/importCli.ts",
    "start": "NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@quixo3/prisma-session-store": "^3.1.19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.1.0",
    "@date-fns/tz": "^1.2.0",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "http-errors": "^2.0.1",
    "jose": "^6.2.3",
    "json-schema-to-ts": "^3.1.1",
    "@json2csv/plainjs": "^7.0.6",
    "kuromoji": "^0.1.2",
    "node-interval-tree": "^2.1.2",
    "node-schedule": "^2.1.1",
    "node-ssh": "^13.2.1",
    "openid-client": "^6.8.4",
    "pg": "^8.21.0",
    "search-query-parser": "^1.6.0",
    "serve-handler": "^6.1.7",
    "spdx-expression-parse": "^4.0.0",
    "strict-uri-encode": "^2.0.0",
    "thread-stream": "^4.2.0",
    "tsx": "^4.22.3",
    "undici": "^8.3.0",
    "yauzl": "^3.3.1",
    "yn": "^5.1.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/kuromoji": "^0.1.3",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.11.11",
    "@types/serve-handler": "^6.1.4",
    "@types/spdx-expression-parse": "^4.0.0",
    "@types/strict-uri-encode": "^2.0.2",
    "@types/yauzl": "^2.10.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "npm-run-all2": "^9.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsdown": "^0.22.1"
  }
}
